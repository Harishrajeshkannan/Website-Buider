# Supabase project connection (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (SECRET — server-only, never exposed to the browser).
# Used only for the sign-in lockout table. From Supabase: Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site placeholder content fallbacks (Req 7.4, 7.5, 14.3)
NEXT_PUBLIC_OWNER_NAME_FALLBACK=Your Name
NEXT_PUBLIC_TAGLINE_FALLBACK=Websites that mean business
NEXT_PUBLIC_CONTACT_EMAIL_FALLBACK=hello@example.com

# Email notifications for new inquiries (Resend — free tier at resend.com)
RESEND_API_KEY=your-resend-api-key
INQUIRY_NOTIFY_TO=you@example.com
INQUIRY_NOTIFY_FROM=onboarding@resend.dev
